# Copie para .env:  cp .env.example .env
# NUNCA coloque a chave do LLM no codigo - so aqui (o .env esta no .gitignore).

# --- LLM ---
# Deixe LLM_API_KEY vazia para usar o MODO SIMULADO (offline)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini

# --- Resiliencia da chamada ao LLM ---
LLM_TIMEOUT=5            # segundos por tentativa
LLM_TENTATIVAS=3         # retentativas com backoff exponencial
CB_LIMITE_FALHAS=5       # falhas seguidas para abrir o disjuntor
CB_ESPERA_SEGUNDOS=20    # tempo aberto antes da chamada de teste (meio-aberto)
LLM_CAOS=nenhum          # padrao da injecao de falhas: nenhum | erro | lento

# --- Enderecos (execucao local; no Docker o compose sobrescreve) ---
URL_REDIS=redis://127.0.0.1:6379/0
URL_INGESTAO=http://127.0.0.1:8001
URL_RECUPERACAO=http://127.0.0.1:8002
DIR_DADOS=dados
